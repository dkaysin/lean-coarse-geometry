module

public import Coarse.Geometry.Group.WordMetricBounds
public import Coarse.Topology.Bornology.MetricallyProperSMul
public import Mathlib.Analysis.InnerProductSpace.PiL2
public import Mathlib.GroupTheory.Finiteness

/-!
# The Švarc–Milnor lemma

A group acting isometrically, metrically properly and coboundedly on a coarsely connected
pseudometric space is finitely generated; if the space is moreover coarsely geodesic,
every orbit map is a quasi-isometry for the word metric of any finite generating family.

## Main statements

* `Group.fg_of_isCoboundedSMul`: the Švarc–Milnor lemma, finite generation.
* `Group.Generators.isQuasiIsometry_smul_const`: the Švarc–Milnor lemma, quasi-isometry.
* `Subgroup.isQuasiIsometry_subtype`: a subgroup of finite index of a finitely generated group is
  quasi-isometric to the group, by the inclusion.
* `Int.quasiIsometric_pi_euclideanSpace`: `ℤⁿ` with a word metric is quasi-isometric to `ℝⁿ`.

## Implementation notes

The space is assumed coarsely connected or coarsely geodesic (`Metric.IsCoarselyConnected`,
`Metric.IsCoarselyGeodesic`) in place of Löh's quasi-geodesic hypothesis. The count of steps
cannot be dropped from the quasi-isometry statement: `ℤ` acting by translations on `ℝ` with the
metric `√|x - y|` satisfies every other hypothesis, and its orbit maps are not quasi-isometries.

Both proofs choose, for each point `y`, a translate `ψ y • s` containing it, for a bounded set
`s ∋ x₀` whose translates cover `X`. Points at distance at most `r` have values of `ψ` that differ
by an element of `{t | (t • B ∩ B).Nonempty}`, where `B` is the closed `r`-thickening of `s`. So
`ψ` is constant modulo the subgroup generated by this set along chains, which gives finite
generation; and `ψ` is a coarse Lipschitz quasi-inverse of the orbit map
(`Metric.IsCoarselyGeodesicWith.coarseLipschitzWith`), which gives the quasi-isometry
(`Metric.CoarseLipschitzWith.isQuasiIsometry`).

The word metric of `P` is the metric of `P.WithWordMetric`; `ℤⁿ` is the `WithWordMetric` of an
additive generating family of `Fin n → ℤ`, whose own metric is the sup metric.

## References

* [C. Löh, *Geometric Group Theory: An Introduction*][loeh2017], Proposition 5.4.1,
  Corollary 5.4.7 and Example 5.2.8
* [C. Druțu, M. Kapovich, *Geometric Group Theory*][drutu2018], Theorem 8.37

## Tags

Švarc–Milnor lemma, Milnor–Švarc lemma, quasi-isometry, word metric, geometric group theory
-/

@[expose] public section

open scoped NNReal Pointwise

variable {G X : Type*} [Group G] [PseudoMetricSpace X] [MulAction G X] [IsIsometricSMul G X]

omit [IsIsometricSMul G X] in
/-- If `a` and `t • a` both lie in `s`, then `t` lies in `{t | (t • B ∩ B).Nonempty}`, where `B` is
the closed `r`-thickening of `s`. -/
private theorem mem_of_smul_mem {s : Set X} {r : ℝ≥0} {t : G} {a : X} (ha : a ∈ s)
    (hta : t • a ∈ s) :
    t ∈ {t : G | (t • Metric.cthickening r s ∩ Metric.cthickening r s).Nonempty} :=
  ⟨t • a, Set.smul_mem_smul_set (Metric.self_subset_cthickening s ha),
    Metric.self_subset_cthickening s hta⟩

/-- If `y ∈ g • s`, `y' ∈ g' • s` and `dist y y' ≤ r`, then `g⁻¹ * g'` lies in
`{t | (t • B ∩ B).Nonempty}`, where `B` is the closed `r`-thickening of `s`. -/
private theorem inv_mul_mem_of_dist_le {s : Set X} {r : ℝ≥0} {g g' : G} {y y' : X}
    (hy : y ∈ g • s) (hy' : y' ∈ g' • s) (hyy' : dist y y' ≤ r) :
    g⁻¹ * g' ∈ {t : G | (t • Metric.cthickening r s ∩ Metric.cthickening r s).Nonempty} := by
  -- `g⁻¹ • y'` lies in `(g⁻¹ * g') • s`, and within `r` of `g⁻¹ • y ∈ s`.
  rw [Set.mem_smul_set_iff_inv_smul_mem] at hy hy'
  refine ⟨g⁻¹ • y', Set.mem_smul_set_iff_inv_smul_mem.2 ?_,
    Metric.mem_cthickening_of_dist_le _ (g⁻¹ • y) _ _ hy ?_⟩
  · rw [smul_smul, mul_inv_rev, inv_inv, mul_inv_cancel_right]
    exact Metric.self_subset_cthickening s hy'
  · rw [dist_smul, dist_comm]
    exact hyy'

/-- **Švarc–Milnor lemma**, finite generation: a group acting isometrically, metrically properly
and coboundedly on a coarsely connected pseudometric space is finitely generated. -/
theorem Group.fg_of_isCoboundedSMul
    (hX : Metric.IsCoarselyConnected X) (hprop : IsMetricallyProperSMul G X)
    (hcob : IsCoboundedSMul G X) : Group.FG G := by
  obtain ⟨r, hr⟩ := hX
  obtain ⟨s, hs, hcov⟩ := hcob
  obtain ⟨x₀⟩ := hr.nonempty
  -- Add `x₀` to `s`, and choose for each `y` a translate `ψ y • insert x₀ s` containing it.
  replace hcov : ⋃ g : G, g • insert x₀ s = Set.univ := Set.eq_univ_of_univ_subset
    (hcov ▸ Set.iUnion_mono fun g ↦ Set.smul_set_mono (Set.subset_insert x₀ s))
  choose ψ hψ using fun y ↦ Set.mem_iUnion.1 (hcov ▸ Set.mem_univ y)
  set S := {t : G | (t • Metric.cthickening r (insert x₀ s) ∩
    Metric.cthickening r (insert x₀ s)).Nonempty}
  refine Group.fg_iff.2 ⟨S, eq_top_iff.2 fun g _ ↦ ?_, hprop _ (hs.insert x₀).cthickening⟩
  -- Along an `r`-chain, consecutive values of `ψ` differ by elements of `S`, so `ψ` is constant
  -- modulo `closure S`.
  have hchain {y y' : X} (p : (Metric.ripsGraph X r).Walk y y') :
      (ψ y : G ⧸ Subgroup.closure S) = ψ y' := by
    induction p with
    | nil => rfl
    | cons h p ih =>
      exact (QuotientGroup.eq.2 <| Subgroup.subset_closure <|
        inv_mul_mem_of_dist_le (hψ _) (hψ _) h.2).trans ih
  obtain ⟨p⟩ := hr.preconnected x₀ (g • x₀)
  -- `g = ψ x₀ * ((ψ x₀)⁻¹ * ψ (g • x₀)) * ((ψ (g • x₀))⁻¹ * g)`, and the outer factors lie in `S`
  -- since they map points of `insert x₀ s` into it.
  have h₁ : ψ x₀ ∈ Subgroup.closure S := Subgroup.subset_closure <|
    mem_of_smul_mem (Set.mem_smul_set_iff_inv_smul_mem.1 (hψ x₀))
      (by rw [smul_inv_smul]; exact s.mem_insert x₀)
  have h₃ : (ψ (g • x₀))⁻¹ * g ∈ Subgroup.closure S := Subgroup.subset_closure <|
    mem_of_smul_mem (s.mem_insert x₀)
      (by rw [mul_smul]; exact Set.mem_smul_set_iff_inv_smul_mem.1 (hψ _))
  simpa using mul_mem (mul_mem h₁ (QuotientGroup.eq.1 (hchain p))) h₃

/-- **Švarc–Milnor lemma**, quasi-isometry: a group acting isometrically, metrically properly and
coboundedly on a nonempty coarsely geodesic pseudometric space is quasi-isometric to the space:
every orbit map `g ↦ g • x₀` is a quasi-isometry for the word metric of any finite generating
family. -/
theorem Group.Generators.isQuasiIsometry_smul_const {ι : Type*} [Finite ι] (P : Generators G ι)
    (hX : Metric.IsCoarselyGeodesic X)
    (hprop : IsMetricallyProperSMul G X) (hcob : IsCoboundedSMul G X) (x₀ : X) :
    Metric.IsQuasiIsometry fun g : P.WithWordMetric ↦ g.ofWordMetric • x₀ := by
  obtain ⟨r, L, C, hr⟩ := hX
  obtain ⟨s, hs, hcov⟩ := hcob
  -- Add `x₀` to `s`, and choose for each `y` a translate `ψ y • insert x₀ s` containing it.
  replace hs := hs.insert x₀
  replace hcov : ⋃ g : G, g • insert x₀ s = Set.univ := Set.eq_univ_of_univ_subset
    (hcov ▸ Set.iUnion_mono fun g ↦ Set.smul_set_mono (Set.subset_insert x₀ s))
  choose ψ hψ using fun y ↦ Set.mem_iUnion.1 (hcov ▸ Set.mem_univ y)
  -- Bound the word lengths of the elements of `{t | (t • B ∩ B).Nonempty}`, and how far the
  -- generators move `x₀`.
  obtain ⟨K, hK⟩ := ((hprop _ hs.cthickening).image P.wordLength).bddAbove
  obtain ⟨D, hD⟩ := (Set.finite_range fun i ↦ dist x₀ (P.val i • x₀)).bddAbove
  -- The orbit map: right multiplication by a generator moves the orbit point by at most `D`.
  have hf : Metric.CoarseLipschitzWith D.toNNReal 0
      fun g : P.WithWordMetric ↦ g.ofWordMetric • x₀ := by
    intro g h
    rw [WithWordMetric.dist_eq, NNReal.coe_zero, add_zero]
    refine P.dist_le_mul_wordLength (φ := (· • x₀)) (fun g i ↦ ?_) _ _
    rw [mul_smul, dist_smul]
    exact (hD ⟨i, rfl⟩).trans (Real.le_coe_toNNReal D)
  -- Its quasi-inverse `ψ`: the values of `ψ` at `r`-close points differ by an element of word
  -- length at most `K`.
  have hψ' : Metric.CoarseLipschitzWith (K * L) (K * C)
      fun y ↦ WithWordMetric.toWordMetric P (ψ y) :=
    hr.coarseLipschitzWith fun y y' hyy' ↦ by
      rw [WithWordMetric.dist_eq]
      exact_mod_cast hK ⟨_, inv_mul_mem_of_dist_le (hψ y) (hψ y') hyy', rfl⟩
  refine hf.isQuasiIsometry hψ' ⟨K, fun g ↦ ?_⟩ ⟨(Metric.diam (insert x₀ s)).toNNReal, fun y ↦ ?_⟩
  · -- `(ψ (g • x₀))⁻¹ * g` maps `x₀` into `insert x₀ s`.
    simp only [Function.comp_apply, id_eq, WithWordMetric.dist_eq]
    exact_mod_cast hK ⟨_, mem_of_smul_mem (s.mem_insert x₀)
      (by rw [mul_smul]; exact Set.mem_smul_set_iff_inv_smul_mem.1 (hψ _)), rfl⟩
  · -- `y` and `ψ y • x₀` both lie in `ψ y • insert x₀ s`.
    obtain ⟨z, hz, hzy⟩ := Set.mem_smul_set.1 (hψ y)
    change dist (ψ y • x₀) y ≤ _
    calc dist (ψ y • x₀) y = dist (ψ y • x₀) (ψ y • z) := by rw [hzy]
      _ = dist x₀ z := dist_smul _ _ _
      _ ≤ _ := (Metric.dist_le_diam_of_mem hs (s.mem_insert x₀) hz).trans
        (Real.le_coe_toNNReal _)

/-- A subgroup of finite index of a group with a finite generating family is quasi-isometric to
the group: the inclusion is a quasi-isometry for the word metrics of any finite generating
families. -/
theorem Subgroup.isQuasiIsometry_subtype (H : Subgroup G) [H.FiniteIndex] {ι κ : Type*}
    [Finite ι] [Finite κ] (P : Group.Generators G ι) (Q : Group.Generators H κ) :
    Metric.IsQuasiIsometry fun h : Q.WithWordMetric ↦
      Group.Generators.WithWordMetric.toWordMetric P (h.ofWordMetric : G) := by
  sorry

/-- `ℤⁿ` with the word metric of a finite generating family is quasi-isometric to `ℝⁿ`.

[C. Löh, *Geometric Group Theory*][loeh2017], Example 5.2.8. -/
theorem Int.quasiIsometric_pi_euclideanSpace {n : ℕ} {ι : Type*} [Finite ι]
    (P : AddGroup.Generators (Fin n → ℤ) ι) :
    Metric.QuasiIsometric P.WithWordMetric (EuclideanSpace ℝ (Fin n)) := by
  sorry
